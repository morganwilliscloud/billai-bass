# Billy's configuration. Copy this file to "billy.env" in the same folder and
# replace each <PLACEHOLDER> with your own value — billy.py loads billy.env
# automatically at startup. Your filled-in billy.env is gitignored; this
# .example is the only one that ships.
#
# Every line is OPTIONAL. Leave one out (or delete the line) and Billy uses
# the built-in default noted beside it.

# Google Calendar + email tools: the AWS Secrets Manager secret holding your
# Google OAuth token (created by google_setup.py). WITHOUT this, Billy still
# does weather and news, but has no calendar or email tools at all.
BILLY_GOOGLE_SECRET_ID=<secrets-manager-secret-name>

# Alternative to the secret above: point straight at a token file on the Pi.
# Set ONE of these, not both. See the README's Google tools section.
# GOOGLE_OAUTH_CREDENTIALS=<path-to-gmail_token.json>

# Where "home" is, for the weather tool. Default: Seattle.
BILLY_LATITUDE=<your-latitude>
BILLY_LONGITUDE=<your-longitude>

# News sources for the headlines tool: comma-separated RSS feed URLs.
# Default: BBC + NPR.
BILLY_NEWS_FEEDS=<comma-separated-rss-feed-urls>

# Only for the OpenAI variant (billy_openai.py); billy.py ignores it.
# OPENAI_API_KEY=<your-openai-api-key>
